<resources>
    <style name="Theme.AppBlock" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F9F5</item>
        <item name="android:navigationBarColor">#F7F9F5</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.AppBlock.Blocked" parent="Theme.AppBlock">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
